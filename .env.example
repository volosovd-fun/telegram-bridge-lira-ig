# telegram-bridge-lira-ig env example
# Production values injected via Trinity credentials/inject API

# Telegram (новий тестовий бот, окремий від IG)
TELEGRAM_BOT_TOKEN=<set via Trinity inject>

# Trinity
TRINITY_API_URL=http://trinity-backend:8000
TARGET_AGENT=lira-ig-v2
# TRINITY_MCP_API_KEY auto-injected by Trinity

# Whitelists (CSV of Telegram user_ids)
ALLOWED_DM_USER_IDS=245649
ALLOWED_GROUP_USER_IDS=245649
ADMIN_USER_IDS=245649

# Multimodal APIs (з Lira-IG)
ELEVENLABS_API_KEY=<from /root/lira-ig/.env>
GEMINI_API_KEY=<from /root/lira-ig/.env>

# Tuning
CONTEXT_SIZE=30
